  <90>Add 1 to 10 and watch the counter count down.<0>

  <90> 1  # Add 1 + 2 + ... + 10. x5 counts down from 10 and<0>
  <90> 2  # x6 collects the sum; bne repeats until x5 is 0.<0>
   3  addi x5, x0, 10    # counter
   4  addi x6, x0, 0     # sum
   5  loop:
   6  add  x6, x6, x5    # sum = sum + counter
   7  addi x5, x5, -1    # counter = counter - 1
   8  bne  x5, x0, loop  # again until the counter is 0

