  <90>RV64 registers hold 64 bits; see what addw keeps.<0>

  <90> 1  # RV64 registers hold 64 bits; build 0x0000_0100_0000_0005<0>
   2  addi x1, x0, 1     # x1 = 1
   3  slli x1, x1, 40    # x1 = 1 << 40
   4  addi x2, x1, 5     # x2 = 0x0000_0100_0000_0005
   5  addw x3, x2, x0    # addw keeps the low 32 bits: 5
   6  addi x4, x0, -1    # -1 sets all 64 bits

