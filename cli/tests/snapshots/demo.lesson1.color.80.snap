  <90>Watch five instructions move through the five stages.<0>

  <90> 1  # Each line is one instruction. Every cycle, each one<0>
  <90> 2  # moves one stage to the right: IF, ID, EX, MEM, WB.<0>
  <90> 3  # Registers are x0 to x31 (x0 is always 0). Each also has<0>
  <90> 4  # an ABI name, such as sp for x2; these lessons use x names.<0>
   5  addi x5, x0, 6     # x5 = 0 + 6
   6  addi x6, x0, 7     # x6 = 0 + 7
   7  addi x7, x0, 100   # x7 = 100
   8  addi x10, x0, 1    # x10 = 1
   9  add  x11, x5, x6   # x11 = 6 + 7 = 13

